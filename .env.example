# Local-only by default. For LAN BACnet, set a concrete interface IP and its prefix.
BACNET_LAB_HTTP_HOST=127.0.0.1
BACNET_LAB_HTTP_PORT=8080
BACNET_LAB_BACNET_IP=127.0.0.1
BACNET_LAB_BACNET_PREFIX=32
BACNET_LAB_BACNET_PORT_START=47808
BACNET_LAB_LOG_LEVEL=INFO
# Compose enforces /app/data/bacnet_lab.db in its persistent volume.
BACNET_LAB_DB_PATH=data/bacnet_lab.db
# Configure BOTH to enable Basic authentication. Use TLS for remote access.
BACNET_LAB_AUTH_USERNAME=
BACNET_LAB_AUTH_PASSWORD=
# Explicit trusted destinations; no wildcard or redirects.
BACNET_LAB_WEBHOOK_ALLOWED_HOSTS=localhost,127.0.0.1
